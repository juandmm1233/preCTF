# --- Base de datos ---
POSTGRES_USER=prectf
POSTGRES_PASSWORD=prectf
POSTGRES_DB=prectf
DATABASE_URL=postgresql+psycopg://prectf:prectf@db:5432/prectf

# --- Secretos (cambiar en clase) ---
JWT_SECRET=cambia-este-jwt-secret-en-clase
TOKEN_SECRET=cambia-este-token-secret-en-clase
INSTRUCTOR_KEY=cambia-esta-clave-de-instructor

# --- Cuenta inicial del instructor (opcional) ---
ADMIN_EMAIL=instructor@ucc.local
ADMIN_PASSWORD=CambiaEstaClave!
ADMIN_CODE=DOCENTE
ADMIN_NAME=Instructor preCTF

# --- Flags de entrenamiento (rotar antes de la clase 15v15) ---
PRECTF_FLAG_N1=FLAG{PRECTF_N1_SQLI}
PRECTF_FLAG_N2=FLAG{PRECTF_N2_COOKIE}
PRECTF_FLAG_N3=FLAG{PRECTF_N3_LFI}
PRECTF_FLAG_N4=FLAG{PRECTF_N4_CONFIG}
PRECTF_FLAG_N5=FLAG{PRECTF_N5_CMDI}
PRECTF_FLAG_N6=FLAG{PRECTF_N6_HASH}
PRECTF_FLAG_N7=FLAG{PRECTF_N7_UPLOAD}
PRECTF_FLAG_N8=FLAG{PRECTF_N8_SSH}

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80
JWT_EXPIRE_HOURS=12

# --- Laboratorios aislados (imagen del instructor, no incluida en este repo) ---
DOCKER_HOST=tcp://dockerproxy:2375
CHALLENGE_N1_IMAGE=prectf-challenge-n1:local
CHALLENGE_NETWORK=prectf_challenges
LAB_BASE_DOMAIN=localhost
LAB_PUBLIC_PORT=8088
LAB_TTL_MINUTES=45
PRECTF_MAX_LAB_SESSIONS=20
LAB_INTERNAL_PORT=80
CTF_LAB_N1_CONTEXT=../CTF ucc/ctf1
TRAEFIK_DYNAMIC_DIR=/traefik/dynamic
